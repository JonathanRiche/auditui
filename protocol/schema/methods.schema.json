{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audible-tui.invalid/protocol/v1/methods.schema.json",
  "title": "Auditui RPC v1 method payloads",
  "$defs": {
    "providerId": { "type": "string", "enum": ["audible", "yoto"] },
    "accountId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "profileName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "pageLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "profileSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" }
      }
    },
    "profileRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "confirm"],
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "confirm": { "const": true }
      }
    },
    "libraryQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" },
        "cursor": { "type": ["string", "null"] },
        "limit": { "$ref": "#/$defs/pageLimit" }
      }
    },
    "librarySearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" },
        "query": { "type": "string", "minLength": 1 },
        "cursor": { "type": ["string", "null"] },
        "limit": { "$ref": "#/$defs/pageLimit" }
      }
    },
    "libraryRefresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" }
      }
    },
    "downloadStart": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["asin"], "properties": { "asin": true } },
        { "required": ["localPath"], "properties": { "localPath": true } }
      ],
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" },
        "asin": { "type": "string", "pattern": "^[A-Za-z0-9]{10}$" },
        "itemId": { "type": "string", "minLength": 1 },
        "format": { "enum": ["aax", "aaxc"] },
        "outputDir": { "type": "string", "minLength": 1 },
        "localPath": { "type": "string", "minLength": 1 }
      }
    },
    "downloadCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId"],
      "properties": { "jobId": { "type": "string", "minLength": 1 } }
    },
    "wishlistList": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "profile": { "$ref": "#/$defs/profileName" } }
    },
    "wishlistMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asin"],
      "properties": {
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" },
        "asin": { "type": "string", "pattern": "^[A-Za-z0-9]{10}$" }
      }
    },
    "playerCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "enum": [
            "play", "pause", "toggle", "stop", "seek-relative",
            "seek-absolute", "chapter-next", "chapter-previous", "chapter-set",
            "set-speed", "set-volume", "bookmark-add", "bookmark-delete",
            "set-sleep-timer", "cancel-sleep-timer", "sleep-end-chapter"
          ]
        },
        "value": { "type": "number" },
        "path": { "type": "string", "minLength": 1 },
        "localPath": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profileName" },
        "provider": { "$ref": "#/$defs/providerId" },
        "account": { "$ref": "#/$defs/accountId" },
        "resume": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "maxLength": 512 },
        "bookmarkId": { "type": "integer", "minimum": 1 }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    }
  }
}
