{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audible-tui.invalid/protocol/v1/request.schema.json",
  "title": "Auditui RPC request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "method"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "method": {
      "type": "string",
      "enum": [
        "health",
        "profile.list",
        "profile.select",
        "profile.status",
        "profile.remove",
        "auth.start",
        "auth.complete",
        "library.list",
        "library.search",
        "library.refresh",
        "wishlist.list",
        "wishlist.add",
        "wishlist.remove",
        "downloads.list",
        "downloads.start",
        "downloads.cancel",
        "player.status",
        "player.command",
        "cancel"
      ]
    },
    "params": { "type": "object" }
  }
}
